UPSERT exercised:[4, 0] MERGE { offset: 4, node_id: 0, label: 'Ticket_Transfer@4', choice_name: 'Ticket_Transfer', target_contract_id: '000003c0de0003', acting_parties: ['Bob::12209c5d1e8a'], consuming: true, result_contract_ids: ['000004c0de0004'], transaction_effective_at: d'2026-11-02T13:28:00Z', choice_arg: { newOwner: 'Carol::1220d2a6b3c7' } };
