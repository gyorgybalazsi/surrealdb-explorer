UPSERT transaction:1 MERGE { offset: 1, label: 'TX@1', update_id: '12200001a0f1', command_id: 'issue-cash-1', workflow_id: '', synchronizer_id: 'global-domain::1220ab', effective_at: d'2026-11-02T10:07:00Z', record_time: d'2026-11-02T10:07:00Z' };
RELATE party:⟨Bank::1220f3a9c1d2⟩->requested->transaction:1;
UPSERT created:⟨000000c0de0000⟩ MERGE { contract_id: '000000c0de0000', label: 'Cash@1', template_name: 'Main.Cash', offset: 1, node_id: 0, signatories: ['Bank::1220f3a9c1d2'], created_at: d'2026-11-02T10:07:00Z', create_arg: { issuer: 'Bank::1220f3a9c1d2', owner: 'Bob::12209c5d1e8a', amount: 50.0, currency: 'USD' } };
RELATE transaction:1->action->created:⟨000000c0de0000⟩;
UPSERT transaction:2 MERGE { offset: 2, label: 'TX@2', update_id: '12200002a0f1', command_id: 'offer-ticket-1', workflow_id: '', synchronizer_id: 'global-domain::1220ab', effective_at: d'2026-11-02T11:14:00Z', record_time: d'2026-11-02T11:14:00Z' };
RELATE party:⟨Venue::1220b7e4a0f5⟩->requested->transaction:2;
