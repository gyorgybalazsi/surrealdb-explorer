RELATE exercised:[3, 0]->consequence->created:⟨000003c0de0003⟩;
UPSERT transaction:4 MERGE { offset: 4, label: 'TX@4', update_id: '12200004a0f1', command_id: 'give-ticket-1', workflow_id: '', synchronizer_id: 'global-domain::1220ab', effective_at: d'2026-11-02T13:28:00Z', record_time: d'2026-11-02T13:28:00Z' };
