RELATE exercised:[4, 0]->consumes->created:⟨000003c0de0003⟩;
UPSERT created:⟨000004c0de0004⟩ MERGE { contract_id: '000004c0de0004', label: 'Ticket@4', template_name: 'Main.Ticket', offset: 4, node_id: 1, signatories: ['Venue::1220b7e4a0f5'], created_at: d'2026-11-02T13:28:00Z', create_arg: { organizer: 'Venue::1220b7e4a0f5', owner: 'Carol::1220d2a6b3c7', event: 'Concert #1' } };
