-- Demo Canton event graph for surrealdb-explorer: 50 transactions, ten rounds of a
-- ticket purchase. Each round: the bank issues cash to a buyer, the venue offers a
-- ticket, the buyer accepts (paying with a nested cash transfer), then either gives
-- the ticket to a friend or (every third round) gets a cash top-up, and finally the
-- ticket is shown at the door. Load into an empty database, e.g. canton/demo.

DEFINE TABLE IF NOT EXISTS action TYPE RELATION;
DEFINE TABLE IF NOT EXISTS consequence TYPE RELATION;
DEFINE TABLE IF NOT EXISTS target TYPE RELATION;
DEFINE TABLE IF NOT EXISTS consumes TYPE RELATION;
DEFINE TABLE IF NOT EXISTS requested TYPE RELATION;
DEFINE INDEX IF NOT EXISTS created_offset ON created FIELDS offset;

UPSERT party:⟨Bank::1220f3a9c1d2⟩ MERGE { party_id: 'Bank::1220f3a9c1d2' };
UPSERT party:⟨Venue::1220b7e4a0f5⟩ MERGE { party_id: 'Venue::1220b7e4a0f5' };
UPSERT party:⟨Bob::12209c5d1e8a⟩ MERGE { party_id: 'Bob::12209c5d1e8a' };
UPSERT party:⟨Carol::1220d2a6b3c7⟩ MERGE { party_id: 'Carol::1220d2a6b3c7' };
UPSERT party:⟨Dave::12204e1f8a90⟩ MERGE { party_id: 'Dave::12204e1f8a90' };
UPSERT party:⟨Erin::1220a0b1c2d3⟩ MERGE { party_id: 'Erin::1220a0b1c2d3' };


